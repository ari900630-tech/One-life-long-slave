<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center"
    android:background="#F7F8FC">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="✦  הסוכן שלי" android:textSize="28sp" android:textStyle="bold" android:textColor="#111827"/>
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:textSize="16sp" android:textColor="#687386" android:gravity="center"/>
    <Button android:id="@+id/enable" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="28dp" android:text="הפעל סוכן צף"/>
</LinearLayout>
